\@writefile{lof}{\contentsline {figure}{\numberline {6.11}{\ignorespaces Äußere Q-Schleife im Modus \texttt  {const\_z}, gekoppelte Variante. Links die Zahl der äußeren Iterationen, rechts der relative Linearisierungsfehler $\varepsilon _{\mathrm  {lin}}$ der Sensitivitätsbeziehung (Median über die äußeren Schritte) über $\rho $. Farbe kodiert die Netzgröße, der Marker den PV-Anteil. Rote Kreuze markieren Läufe ohne Konvergenz innerhalb von $60$ äußeren Iterationen, die graue Linie im rechten Diagramm die Referenzsteigung $\propto \rho ^{2}$ nach Gl.~\eqref  {eq:lin-error-scaling}. Kernaussage: Plateau bis $\rho \approx 1$ bei drei Iterationen, danach Anstieg gemeinsam mit $\varepsilon _{\mathrm  {lin}}$.}}{51}{figure.caption.56}\protected@file@percent }
\newlabel{fig:rx-outer}{{6.11}{51}{Äußere Q-Schleife im Modus \texttt {const\_z}, gekoppelte Variante. Links die Zahl der äußeren Iterationen, rechts der relative Linearisierungsfehler $\varepsilon _{\mathrm {lin}}$ der Sensitivitätsbeziehung (Median über die äußeren Schritte) über $\rho $. Farbe kodiert die Netzgröße, der Marker den PV-Anteil. Rote Kreuze markieren Läufe ohne Konvergenz innerhalb von $60$ äußeren Iterationen, die graue Linie im rechten Diagramm die Referenzsteigung $\propto \rho ^{2}$ nach Gl.~\eqref {eq:lin-error-scaling}. Kernaussage: Plateau bis $\rho \approx 1$ bei drei Iterationen, danach Anstieg gemeinsam mit $\varepsilon _{\mathrm {lin}}$}{figure.caption.56}{}}
\newlabel{fig:rx-outer@cref}{{[figure][11][6]6.11}{[1][50][]51}}
