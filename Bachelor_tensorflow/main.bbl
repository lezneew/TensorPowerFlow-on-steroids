      \strng{fullhash}{ccb8caa274cdcaafeb1d5da076ed1bb9}
      \strng{bibnamehash}{ccb8caa274cdcaafeb1d5da076ed1bb9}
      \strng{authorbibnamehash}{ccb8caa274cdcaafeb1d5da076ed1bb9}
      \strng{authornamehash}{cc3b883f55e42ce227c189dc3fae4164}
